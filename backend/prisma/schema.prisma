// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
    id Int @id @default(autoincrement())
    username String @unique
    email String @unique
    passwordHash String
    roles String[]
    active Boolean @default(true)
    status UserStatus @default(PENDING)

    firstName String?
    lastName String?
    phone String?
    address String?
    city String?
    country String?
    lat Float?
    lng Float?
    afm String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    organizedEvents Event[] @relation("OrganizerEvents")
    bookings Booking[]
    views EventView[]
    sentMessages Message[] @relation("SentMessages")
    receivedMessages Message[] @relation("ReceivedMessages")
}

model Category {
    id Int @id @default(autoincrement())
    name String @unique
    events Event[]
}

model Event {
    id Int @id @default(autoincrement())
    eventId String @unique
    title String
    eventType String
    venue String
    address String
    city String
    country String
    lat Float?
    lng Float?
    startDateTime DateTime
    endDateTime DateTime
    capacity Int
    status EventStatus @default(DRAFT)
    description String

    organizerId Int
    organizer User @relation("OrganizerEvents", fields: [organizerId], references: [id])

    categories Category[]
    ticketTypes TicketType[]
    bookings Booking[]
    photos Photo[]
    views EventView[]
    messages Message[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@index([startDateTime])
    @@index([city])
}

model TicketType {
    id Int @id @default(autoincrement())
    ticketTypeId String
    eventId Int
    event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
    name String
    price Decimal
    quantity Int
    available Int

    bookings Booking[]

    @@unique([eventId, ticketTypeId])
}

model Booking {
    id Int @id @default(autoincrement())
    bookingId String @unique
    eventId Int
    event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
    attendeeId Int
    attendee User @relation(fields: [attendeeId], references: [id])
    time DateTime @default(now())
    ticketTypeId Int
    ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
    numberOfTickets Int
    totalCost Decimal
    status BookingStatus @default(CONFIRMED)

    @@index([eventId])
    @@index([attendeeId])
}

model Photo {
    id Int @id @default(autoincrement())
    eventId Int
    event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
    url String
}

model Message {
    id Int @id @default(autoincrement())
    senderId Int
    sender User @relation("SentMessages", fields: [senderId], references: [id])
    recipientId Int
    recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id])
    eventId Int?
    event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
    subject String
    body String
    sentAt DateTime @default(now())
    readAt DateTime?
    deletedBySender Boolean @default(false)
    deletedByRecipient Boolean @default(false)

    @@index([recipientId])
    @@index([senderId])
}

model EventView {
    id Int @id @default(autoincrement())
    userId Int
    user User @relation(fields: [userId], references: [id])
    eventId Int
    event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
    viewedAt DateTime @default(now())

    @@index([userId])
    @@index([eventId])
}
